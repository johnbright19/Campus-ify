# ---------------------------------------------------------------------------
# Campus-ify · client environment (reference only)
#
# This build ships with a fully in-browser mock backend, so the app runs with
# ZERO configuration. The variables below document what a real deployment
# (Supabase + Node API) would supply — copy to `.env` and fill in when you
# connect the actual server. See Architecture.md §11.
# ---------------------------------------------------------------------------

# Supabase (Auth + Realtime + Postgres read access)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Node/Express API (all writes go through here)
VITE_API_URL=http://localhost:4000

# Optional: lock sign-in to a college domain
VITE_ALLOWED_EMAIL_DOMAIN=

# Vendor label shown in the UI for the AI layer
VITE_AI_VENDOR=Anthropic
